@using Altinay.Blazor.Models
@inherits GanttChartBase

<div class="gantt-wrapper">
    <div class="gantt-header">
        @foreach (var d in HeaderDays)
        {
            <div class="gantt-header-cell" style="width:@PxPerDayPx">@d:dd MMM</div>
        }
    </div>

    <div class="gantt-body" @ref="_ganttBodyRef">
        @for (int i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var left = (item.Start.Date - MinDate.Date).TotalDays * PxPerDay;
            var width = Math.Max(1, (item.End.Date - item.Start.Date).TotalDays + 1) * PxPerDay;
            var top = i * RowHeight;

            <div class="gantt-row" style="top:@($"{top}px")"></div>
            <div class="gantt-bar"
                 data-id="@item.Id"
                 style="left:@($"{left}px"); width:@($"{width}px"); top:@($"{top + BarTopOffset}px")">
                <span class="gantt-bar-label">@item.Title</span>
                <div class="gantt-resize-left"></div>
                <div class="gantt-resize-right"></div>
            </div>
        }
    </div>
</div>

<style>
    .gantt-wrapper { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
    .gantt-header { display: flex; background: #f8fafc; border-bottom: 1px solid #e5e7eb; }
    .gantt-header-cell { padding: 8px; text-align: center; font-weight: 600; border-right: 1px solid #e5e7eb; }
    .gantt-body { position: relative; min-height: 400px; }
    .gantt-row { position: absolute; height: 40px; border-bottom: 1px solid #f3f4f6; width: 100%; }
    .gantt-bar { position: absolute; background: #3b82f6; color: white; padding: 4px 8px; border-radius: 4px; cursor: move; }
    .gantt-bar-label { font-size: 12px; font-weight: 500; }
    .gantt-resize-left, .gantt-resize-right { position: absolute; top: 0; bottom: 0; width: 4px; cursor: ew-resize; }
    .gantt-resize-left { left: 0; }
    .gantt-resize-right { right: 0; }
</style>
