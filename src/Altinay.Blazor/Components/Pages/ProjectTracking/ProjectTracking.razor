@code {
	// Tab Navigation için state
	private string currentView = "kanban"; // Varsayılan görünüm
	
	/// <summary>
	/// Tab görünümünü değiştir
	/// </summary>
	/// <param name="view">Görünüm adı: "kanban" veya "gantt"</param>
	private void SwitchView(string view)
	{
		currentView = view;
		StateHasChanged(); // UI'yi güncelle
	}

    /// <summary>
    /// Tüm görevleri Gantt Chart için getir
    /// </summary>
    /// <returns>Tüm görevlerin listesi</returns>
    private List<TrackingIssueDto> GetAllIssues()
    {
        var allIssues = new List<TrackingIssueDto>();
        
        if (todo != null) allIssues.AddRange(todo);
        if (inprogress != null) allIssues.AddRange(inprogress);
        if (review != null) allIssues.AddRange(review);
        if (done != null) allIssues.AddRange(done);
        
        return allIssues;
    }

    /// <summary>
    /// Gantt Chart'tan görev seçildiğinde
    /// </summary>
    /// <param name="selectedTask">Seçilen görev</param>
    private async Task OnGanttTaskSelected(TrackingIssueDto selectedTask)
    {
        // Seçilen görevi detay modal'da aç
        await _detailModal.ShowAsync(selectedTask);
        
        // Kanban görünümüne geç
        SwitchView("kanban");
    }
    
    /// <summary>
    /// Gantt Chart'ta görev güncellendiğinde - KANBAN ENTEGRASYONU
    /// </summary>
    /// <param name="updatedTask">Güncellenen görev</param>
    private async Task OnGanttTaskUpdated(GanttTaskData updatedTask)
    {
        try
        {
            Console.WriteLine($"Gantt'tan güncelleme geldi: {updatedTask.Task}");
            
            // Kanban'daki issue'yu güncelle
            var issue = GetAllIssues().FirstOrDefault(x => x.Id == Guid.Parse(updatedTask.Id));
            if (issue != null)
            {
                issue.StartDate = updatedTask.StartDate;
                issue.DueDate = updatedTask.EndDate;
                issue.EstimatedDays = updatedTask.Duration;
                    issue.Status = (IssueStatus)Enum.Parse(typeof(IssueStatus), updatedTask.Status);
                    issue.Priority = (IssuePriority)Enum.Parse(typeof(IssuePriority), updatedTask.Priority);
                
                Console.WriteLine($"Kanban güncellendi: {issue.Title}");
                Console.WriteLine($"Yeni Start Date: {issue.StartDate:dd/MM/yyyy}");
                Console.WriteLine($"Yeni Due Date: {issue.DueDate:dd/MM/yyyy}");
                Console.WriteLine($"Yeni Duration: {issue.EstimatedDays} gün");
            }
            
            // Kanban görünümündeyse UI'ı yenile
            if (currentView == "kanban")
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Kanban güncelleme hatası: {ex.Message}");
        }
    }

	public class NotificationItem
	{
		public Guid Id { get; set; }
		public string Title { get; set; } = string.Empty;
		public string Message { get; set; } = string.Empty;
		public string Type { get; set; } = string.Empty;
		public DateTime Time { get; set; }
		public bool IsRead { get; set; }
	}

}
