</style>

@code {
	private List<TrackingIssueDto>? todo;
	private List<TrackingIssueDto>? inprogress;
	private List<TrackingIssueDto>? review;
	private List<TrackingIssueDto>? done;

	private string _searchFilter = string.Empty;
	private string _groupBy = "status";
	private IssueStatus? _dragOverColumn;
	private Guid? _draggedIssueId;
	private Guid? _selectedProjectId;
	private List<TrackingProjectDto> _projects = new();
	private bool _isProcessing = false;

	private IssueCreateModal? _createModal;
	private IssueDetailModal? _detailModal;

	protected override async Task OnInitializedAsync()
	{
		_currentInstance = this;
		await LoadProjectsAsync();
		await ReloadAsync();
	}

	private async Task LoadProjectsAsync()
	{
		var result = await ProjectApp.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 1000 });
		_projects = result.Items.ToList();
	}

	private async Task ReloadAsync()
	{
		var input = new TrackingIssueSearchInput
		{
			MaxResultCount = 1000,
			Sorting = "CreationTime desc",
			ProjectId = _selectedProjectId
		};

		var result = await IssueApp.GetListAsync(input);
		var filteredIssues = result.Items.AsEnumerable();

		// Apply search filter
		if (!string.IsNullOrEmpty(_searchFilter))
		{
			filteredIssues = filteredIssues.Where(x => 
				x.Title.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
				(x.Description != null && x.Description.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
			);
		}

		// Apply grouping
		if (_groupBy == "status")
		{
			todo = filteredIssues.Where(x => x.Status == IssueStatus.ToDo).ToList();
			inprogress = filteredIssues.Where(x => x.Status == IssueStatus.InProgress).ToList();
			review = filteredIssues.Where(x => x.Status == IssueStatus.InReview).ToList();
			done = filteredIssues.Where(x => x.Status == IssueStatus.Done).ToList();
		}
		else if (_groupBy == "priority")
		{
			todo = filteredIssues.Where(x => x.Priority == IssuePriority.Critical).ToList();
			inprogress = filteredIssues.Where(x => x.Priority == IssuePriority.High).ToList();
			review = filteredIssues.Where(x => x.Priority == IssuePriority.Medium).ToList();
			done = filteredIssues.Where(x => x.Priority == IssuePriority.Low).ToList();
		}
		else if (_groupBy == "project")
		{
			// Group by project - show all issues in first column
			todo = filteredIssues.ToList();
			inprogress = new List<TrackingIssueDto>();
			review = new List<TrackingIssueDto>();
			done = new List<TrackingIssueDto>();
		}
		else if (_groupBy == "assignee")
		{
			// Group by assignee - Unassigned vs Assigned
			todo = filteredIssues.Where(x => !x.AssigneeUserId.HasValue).ToList();
			inprogress = filteredIssues.Where(x => x.AssigneeUserId.HasValue).ToList();
			review = new List<TrackingIssueDto>();
			done = new List<TrackingIssueDto>();
		}
		else
		{
			// Default status grouping
			todo = filteredIssues.Where(x => x.Status == IssueStatus.ToDo).ToList();
			inprogress = filteredIssues.Where(x => x.Status == IssueStatus.InProgress).ToList();
			review = filteredIssues.Where(x => x.Status == IssueStatus.InReview).ToList();
			done = filteredIssues.Where(x => x.Status == IssueStatus.Done).ToList();
		}

		StateHasChanged();
	}

	private async Task OnProjectChanged(ChangeEventArgs e)
	{
		_selectedProjectId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : Guid.Parse(e.Value.ToString()!);
		await ReloadAsync();
	}

	private async Task OnDragStart(Guid issueId)
	{
		_draggedIssueId = issueId;
		await JSRuntime.InvokeVoidAsync("setDraggedIssue", issueId.ToString());
	}

	private async Task OnDragOver(IssueStatus status)
	{
		_dragOverColumn = status;
		StateHasChanged();
	}

	private async Task OnDragLeave()
	{
		_dragOverColumn = null;
		StateHasChanged();
	}

	private async Task OnDrop(IssueStatus newStatus)
	{
		if (_draggedIssueId.HasValue)
		{
			try
			{
				await IssueApp.ChangeStatusAsync(_draggedIssueId.Value, newStatus);
				await ReloadAsync();
			}
			catch (Exception ex)
			{
				// Handle error
				Console.WriteLine($"Error updating status: {ex.Message}");
			}
		}

		_draggedIssueId = null;
		_dragOverColumn = null;
		StateHasChanged();
	}

	private async Task OnSearchChanged(ChangeEventArgs e)
	{
		_searchFilter = e?.Value?.ToString() ?? string.Empty;
		await ReloadAsync();
	}

	private async Task OnGroupByChanged(ChangeEventArgs e)
	{
		_groupBy = e?.Value?.ToString() ?? "status";
		await ReloadAsync();
	}

	private void HandleCardDragStart(Guid issueId)
	{
		_draggedIssueId = issueId;
	}


	[JSInvokable]
	public static async Task OnDropLocal(string newStatus)
	{
		// Get the current component instance
		var component = GetCurrentComponent();
		if (component != null)
		{
			await component.OnDropLocalInstance(newStatus);
		}
	}

	public async Task OnDropLocalInstance(string newStatus)
	{
		if (_isProcessing) return; // Prevent multiple simultaneous operations
		
		if (_draggedIssueId.HasValue && Enum.TryParse<IssueStatus>(newStatus, out var status))
		{
			_isProcessing = true;
			try
			{
				Console.WriteLine($"Processing drop: {_draggedIssueId.Value} -> {status}");
				await IssueApp.ChangeStatusAsync(_draggedIssueId.Value, status);
				await ReloadAsync();
				Console.WriteLine("Drop operation completed successfully");
			}
			catch (Exception ex)
			{
				Console.WriteLine($"Error updating status: {ex.Message}");
			}
			finally
			{
				_isProcessing = false;
			}
		}

		_draggedIssueId = null;
		_dragOverColumn = null;
		StateHasChanged();
	}

	private static ProjectTracking? _currentInstance;
	private static ProjectTracking? GetCurrentComponent()
	{
		return _currentInstance;
	}

	private string GetDragOverClass(IssueStatus status)
	{
		return _dragOverColumn == status ? "drag-over" : string.Empty;
	}

	private async Task OpenNewIssueAsync()
	{
		if (_createModal != null)
		{
			await _createModal.ShowAsync();
		}
	}

	private async Task OpenDetailModalAsync(TrackingIssueDto issue)
	{
		Console.WriteLine($"Opening modal for issue: {issue.Title}");
		if (_detailModal != null)
		{
			Console.WriteLine("Modal reference found, calling ShowAsync");
			await _detailModal.ShowAsync(issue);
		}
		else
		{
			Console.WriteLine("Modal reference is null!");
		}
	}

	private async Task CloseDetailModal()
	{
		if (_detailModal != null)
		{
			await _detailModal.HideAsync();
		}
	}


	private async Task ChangeIssueStatus(Guid issueId, IssueStatus newStatus)
	{
		try
		{
			await IssueApp.ChangeStatusAsync(issueId, newStatus);
			await ReloadAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error changing status: {ex.Message}");
		}
	}

	private string GetColumnTitle(int columnIndex)
	{
		return _groupBy switch
		{
			"status" => columnIndex switch
			{
				0 => "TO DO",
				1 => "IN PROGRESS",
				2 => "IN REVIEW",
				3 => "DONE",
				_ => "UNKNOWN"
			},
			"priority" => columnIndex switch
			{
				0 => "CRITICAL",
				1 => "HIGH",
				2 => "MEDIUM",
				3 => "LOW",
				_ => "UNKNOWN"
			},
			"project" => columnIndex switch
			{
				0 => "ALL PROJECTS",
				1 => "",
				2 => "",
				3 => "",
				_ => "UNKNOWN"
			},
			"assignee" => columnIndex switch
			{
				0 => "UNASSIGNED",
				1 => "ASSIGNED",
				2 => "",
				3 => "",
				_ => "UNKNOWN"
			},
			_ => "UNKNOWN"
		};
	}

	private async Task DeleteIssue(Guid issueId)
	{
		try
		{
			await IssueApp.DeleteAsync(issueId);
			await ReloadAsync();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error deleting issue: {ex.Message}");
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JSRuntime.InvokeVoidAsync("setupDragAndDrop");
		}
		else
		{
			await JSRuntime.InvokeVoidAsync("refreshDragAndDrop");
		}
	}
}