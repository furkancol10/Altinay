	/* Modern Header Styles */
	.board-header {
		background: white;
		border-radius: 12px;
		padding: 20px 24px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 0, 0, 0.05);
