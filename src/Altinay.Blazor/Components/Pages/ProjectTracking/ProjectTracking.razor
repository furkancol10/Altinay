@page "/project-tracking"

@using Microsoft.AspNetCore.Components.Web
@using Volo.Abp.Application.Dtos
@using Altinay.ProjectTracking.IAppServices
@using Altinay.ProjectTracking.ProjectTrackingDtos
@using Altinay.Domain.ProjectTracking
@using Altinay.Blazor.Components
@using Volo.Abp.Users
@using System.Threading

@inject ITrackingIssueAppService IssueApp
@inject ITrackingProjectAppService ProjectApp
@inject IJSRuntime JSRuntime
@inject ICurrentUser CurrentUser

<PageTitle>Project Tracking</PageTitle>

<!-- Üst şerit -->
<div class="board-header mb-4">
	<div class="d-flex align-items-center justify-content-between">
		<div class="d-flex align-items-center">
			<h4 class="fw-bold mb-0 me-4">Board</h4>
			
			<!-- Tab Navigation -->
			<div class="view-tabs me-4">
				<button class="tab-btn @(currentView == "kanban" ? "active" : "")" 
						@onclick="@(() => SwitchView("kanban"))">
					<i class="fas fa-columns me-2"></i>
					Kanban Board
				</button>
				<button class="tab-btn @(currentView == "gantt" ? "active" : "")" 
						@onclick="@(() => SwitchView("gantt"))">
					<i class="fas fa-chart-gantt me-2"></i>
					Gantt Chart
				</button>
			</div>

			<div class="search-container me-3">
				<div class="search-input-wrapper">
					<i class="fas fa-search search-icon"></i>
					<input class="search-input"
						   placeholder="Search tasks..."
						   value="@_searchFilter"
				   @oninput="OnSearchChanged" />
				</div>
			</div>
		</div>

		<div class="d-flex align-items-center">
			<!-- Bildirim Butonu -->
			<button class="btn btn-outline-primary me-3" @onclick="ShowNotificationModal">
				<i class="fas fa-bell me-2"></i>
				Bildirimler
				@if (_unreadNotificationCount > 0)
				{
					<span class="badge bg-danger ms-2">@_unreadNotificationCount</span>
				}
			</button>

			<!-- Project Filter -->
			<div class="filter-group me-3">
				<label class="filter-label">Project</label>
				<select class="filter-select" @onchange="OnProjectChanged">
					<option value="">All Projects</option>
					@foreach (var project in _projects)
					{
						<option value="@project.Id" selected="@(project.Id == _selectedProjectId)">@project.Name</option>
					}
				</select>
			</div>

			<!-- Group By Filter -->
			<div class="filter-group me-3">
				<label class="filter-label">Group By</label>
				<select class="filter-select" @onchange="OnGroupByChanged">
					<option value="status" selected="@(_groupBy == "status")">Status</option>
					<option value="priority" selected="@(_groupBy == "priority")">Priority</option>
					<option value="project" selected="@(_groupBy == "project")">Project</option>
					<option value="assignee" selected="@(_groupBy == "assignee")">Assignee</option>
				</select>
			</div>

			<!-- New Issue Button -->
			<button class="btn btn-primary btn-sm" @onclick="OpenNewIssueAsync">
				<i class="fas fa-plus me-1"></i>
				New Issue
			</button>
		</div>
	</div>

</div>

<!-- Content Area -->
@if (currentView == "kanban")
{
	<!-- Kanban Board -->
	<div class="kanban-board">
	<div class="kanban-container">

		<!-- TO DO -->
		<div class="kanban-column">
			<div class="column-header">
				<div class="column-title">
					<span class="fw-bold">@GetColumnTitle(0)</span>
					<span class="badge bg-light text-dark ms-2">@(todo?.Count ?? 0)</span>
				</div>
			</div>

			<div class="column-content @(GetDragOverClass(IssueStatus.ToDo))"
				 @ondragover:preventDefault
				 @ondragenter="() => _dragOverColumn = IssueStatus.ToDo"
				 @ondragleave="() => _dragOverColumn = null"
				 @ondrop="@(() => OnDropLocal("ToDo"))">
				@if (todo is null)
				{
					<div class="text-muted small">Loading...</div>
				}
				else if (!todo.Any())
				{
					<div class="empty-column">
						<span class="text-muted">No tasks</span>
					</div>
				}
				else
				{
					@foreach (var i in todo)
					{
						<IssueCard Issue="i"
								   OnClick="() => OpenDetailModalAsync(i)"
								   OnDragStart="OnDragStart"
								   OnStatusChange="(status) => ChangeIssueStatus(i.Id, status)"
								   OnDelete="DeleteIssue" />
					}
				}
			</div>
		</div>

		<!-- IN PROGRESS -->
		<div class="kanban-column">
			<div class="column-header">
				<div class="column-title">
					<span class="fw-bold">@GetColumnTitle(1)</span>
					<span class="badge bg-light text-dark ms-2">@(inprogress?.Count ?? 0)</span>
				</div>
			</div>

			<div class="column-content @(GetDragOverClass(IssueStatus.InProgress))"
				 @ondragover:preventDefault
				 @ondragenter="() => _dragOverColumn = IssueStatus.InProgress"
				 @ondragleave="() => _dragOverColumn = null"
				 @ondrop="@(() => OnDropLocal("InProgress"))">
				@if (inprogress is null)
				{
					<div class="text-muted small">Loading...</div>
				}
				else if (!inprogress.Any())
				{
					<div class="empty-column">
						<span class="text-muted">No tasks</span>
					</div>
				}
				else
				{
					@foreach (var i in inprogress)
					{
						<IssueCard Issue="i"
								   OnClick="() => OpenDetailModalAsync(i)"
								   OnDragStart="OnDragStart"
								   OnStatusChange="(status) => ChangeIssueStatus(i.Id, status)"
								   OnDelete="DeleteIssue" />
					}
				}
			</div>
		</div>

		<!-- IN REVIEW -->
		<div class="kanban-column">
			<div class="column-header">
				<div class="column-title">
					<span class="fw-bold">@GetColumnTitle(2)</span>
					<span class="badge bg-light text-dark ms-2">@(review?.Count ?? 0)</span>
				</div>
			</div>

			<div class="column-content @(GetDragOverClass(IssueStatus.InReview))"
				 @ondragover:preventDefault
				 @ondragenter="() => _dragOverColumn = IssueStatus.InReview"
				 @ondragleave="() => _dragOverColumn = null"
				 @ondrop="@(() => OnDropLocal("InReview"))">
				@if (review is null)
				{
					<div class="text-muted small">Loading...</div>
				}
				else if (!review.Any())
				{
					<div class="empty-column">
						<span class="text-muted">No tasks</span>
					</div>
				}
				else
				{
					@foreach (var i in review)
					{
						<IssueCard Issue="i"
								   OnClick="() => OpenDetailModalAsync(i)"
								   OnDragStart="OnDragStart"
								   OnStatusChange="(status) => ChangeIssueStatus(i.Id, status)"
								   OnDelete="DeleteIssue" />
					}
				}
			</div>
		</div>

		<!-- DONE -->
		<div class="kanban-column">
			<div class="column-header">
				<div class="column-title">
					<span class="fw-bold">@GetColumnTitle(3)</span>
					<span class="badge bg-light text-dark ms-2">@(done?.Count ?? 0)</span>
				</div>
			</div>

			<div class="column-content @(GetDragOverClass(IssueStatus.Done))"
				 @ondragover:preventDefault
				 @ondragenter="() => _dragOverColumn = IssueStatus.Done"
				 @ondragleave="() => _dragOverColumn = null"
				 @ondrop="@(() => OnDropLocal("Done"))">
				@if (done is null)
				{
					<div class="text-muted small">Loading...</div>
				}
				else if (!done.Any())
				{
					<div class="empty-column">
						<span class="text-muted">No tasks</span>
					</div>
				}
				else
				{
					@foreach (var i in done)
					{
						<IssueCard Issue="i"
								   OnClick="() => OpenDetailModalAsync(i)"
								   OnDragStart="OnDragStart"
								   OnStatusChange="(status) => ChangeIssueStatus(i.Id, status)"
								   OnDelete="DeleteIssue" />
					}
				}
			</div>
		</div>

	</div>
	</div>
}
else if (currentView == "gantt")
{
            <!-- Gantt Chart -->
            <div class="gantt-chart-container">
                <GanttChart Issues="@GetAllIssues()" OnTaskSelected="@OnGanttTaskSelected" OnIssueCreated="@ReloadAsync" />
            </div>
}

<!-- Modals -->
<IssueCreateModal @ref="_createModal" OnSaved="ReloadAsync" />
<CascadingValue Value="this">
    <IssueDetailModal @ref="_detailModal" OnClose="CloseDetailModal" />
</CascadingValue>

<style>
