	private async Task CheckTodoOverload()
	{
		try
		{
			// To-do sayısını al - tüm kolonlardaki issue sayısından
			var todoCount = (todo?.Count ?? 0) + (inprogress?.Count ?? 0) + (review?.Count ?? 0) + (done?.Count ?? 0);
			
			// Eğer 10'dan fazla to-do varsa bildirim gönder
			if (todoCount > 10)
			{
				var title = "⚠️ To-Do Listesi Kalabalık!";
				var message = $"Şu anda {todoCount} adet görevin var! Önceliklerini belirle ve odaklan.";
				
				// Pop-up bildirim göster
				await JSRuntime.InvokeVoidAsync("showToastNotification", title, message, "todo-overload");
				
				// Bildirim listesine de ekle
				_notifications.Add(new NotificationItem
				{
					Id = Guid.NewGuid(),
					Title = title,
					Message = message,
					Type = "todo-overload",
					Time = DateTime.Now,
					IsRead = false
				});
				_unreadNotificationCount++;
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			// Hata durumunda sessizce geç
			Console.WriteLine($"To-do kontrol hatası: {ex.Message}");
		}
	}

	private async Task CheckDeadlineNotifications()
	{
		try
		{
			var now = DateTime.Now;
			var upcomingDeadlines = new List<TrackingIssueDto>();
			
			// Tüm kolonlardaki görevleri kontrol et
			var allIssues = new List<TrackingIssueDto>();
			if (todo != null) allIssues.AddRange(todo);
			if (inprogress != null) allIssues.AddRange(inprogress);
			if (review != null) allIssues.AddRange(review);
			if (done != null) allIssues.AddRange(done);
			
			foreach (var issue in allIssues)
			{
				if (issue.DueDate.HasValue && issue.Status != IssueStatus.Done)
				{
					var timeLeft = issue.DueDate.Value - now;
					
					// Son 24 saat içinde bitecek görevler
					if (timeLeft.TotalHours <= 24 && timeLeft.TotalHours > 0)
					{
						upcomingDeadlines.Add(issue);
					}
				}
			}
			
			// Deadline yaklaşan görevler varsa bildirim gönder
			if (upcomingDeadlines.Any())
			{
				var title = "⏰ Deadline Yaklaşıyor!";
				var message = $"{upcomingDeadlines.Count} görevin deadline'ı yaklaşıyor! Hemen kontrol et.";
				
				// Pop-up bildirim göster
				await JSRuntime.InvokeVoidAsync("showToastNotification", title, message, "deadline");
				
				// Bildirim listesine de ekle
				_notifications.Add(new NotificationItem
				{
					Id = Guid.NewGuid(),
					Title = title,
					Message = message,
					Type = "deadline",
					Time = DateTime.Now,
					IsRead = false
				});
				_unreadNotificationCount++;
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			// Hata durumunda sessizce geç
			Console.WriteLine($"Deadline kontrol hatası: {ex.Message}");
		}
	}

