	private async Task LoadNotificationsFromStorage()
	{
		try
		{
			var storedNotifications = await JSRuntime.InvokeAsync<string>("getNotificationsFromStorage");
			if (!string.IsNullOrEmpty(storedNotifications))
			{
				var notifications = System.Text.Json.JsonSerializer.Deserialize<List<dynamic>>(storedNotifications);
				foreach (var notification in notifications)
				{
					var notificationItem = new NotificationItem
					{
						Id = Guid.Parse(notification.GetProperty("id").GetString()),
						Title = notification.GetProperty("title").GetString(),
						Message = notification.GetProperty("message").GetString(),
						Type = notification.GetProperty("type").GetString(),
						Time = DateTime.Parse(notification.GetProperty("time").GetString()),
						IsRead = notification.GetProperty("isRead").GetBoolean()
					};
					
					_notifications.Add(notificationItem);
					if (!notificationItem.IsRead)
					{
						_unreadNotificationCount++;
					}
				}
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Bildirim yükleme hatası: {ex.Message}");
		}
	}

	private void ShowNotificationModal()
	{
		_showNotificationModal = true;
