	private void MarkAsRead(Guid notificationId)
	{
		var notification = _notifications.FirstOrDefault(n => n.Id == notificationId);
		if (notification != null && !notification.IsRead)
		{
			notification.IsRead = true;
			_unreadNotificationCount--;
			StateHasChanged();
		}
	}

	private void DeleteNotification(Guid notificationId)
	{
		var notification = _notifications.FirstOrDefault(n => n.Id == notificationId);
		if (notification != null)
		{
			_notifications.Remove(notification);
			if (!notification.IsRead)
			{
				_unreadNotificationCount--;
			}
			StateHasChanged();
		}
	}

	private void AddQuickReminder()
	{
		_showQuickReminderModal = true;
		StateHasChanged();
	}

	private void HideQuickReminderModal()
	{
		_showQuickReminderModal = false;
		_newReminderTitle = "";
		_newReminderMessage = "";
		_newReminderTime = DateTime.Now.AddMinutes(3);
		StateHasChanged();
	}

	private async Task SaveQuickReminder()
	{
		if (!string.IsNullOrWhiteSpace(_newReminderTitle))
		{
			var reminderId = Guid.NewGuid();
			var reminderItem = new NotificationItem
			{
				Id = reminderId,
				Title = _newReminderTitle,
				Message = _newReminderMessage,
				Type = "reminder",
				Time = _newReminderTime,
				IsRead = false
			};
			
			// Bildirim listesine EKLEME! Sadece zamanlı hatırlatıcı ayarla
			await ScheduleReminder(reminderItem);
			
			HideQuickReminderModal();
		}
	}

	private async Task ScheduleReminder(NotificationItem reminder)
	{
		var delay = reminder.Time - DateTime.Now;
		if (delay.TotalMilliseconds > 0)
		{
			// Timer ile hatırlatıcı ayarla - InvokeVoidAsync kullan
			_reminderTimer = new Timer(async _ => 
			{
				await InvokeAsync(async () => await ShowScheduledReminder(reminder));
			}, null, delay, Timeout.InfiniteTimeSpan);
		}
		else
		{
			// Zaman geçmişse hemen göster
			await ShowScheduledReminder(reminder);
		}
	}

	private async Task ShowScheduledReminder(NotificationItem reminder)
	{
		// Pop-up bildirim göster
		await JSRuntime.InvokeVoidAsync("showToastNotification", reminder.Title, reminder.Message, "reminder");
		
		// Şimdi bildirim listesine ekle
		_notifications.Add(reminder);
		_unreadNotificationCount++;
		StateHasChanged();
	}
}

