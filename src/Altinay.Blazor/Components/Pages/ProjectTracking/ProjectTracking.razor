												<i class="fas fa-users text-primary"></i>
											}
											else if (notification.Type == "comment")
											{
												<i class="fas fa-comment text-info"></i>
											}
											else
											{
												<i class="fas fa-bell text-primary"></i>
											}
										</div>
										<div class="flex-grow-1">
											<h6 class="mb-1">@notification.Title</h6>
											<p class="mb-1 text-muted">@notification.Message</p>
											<small class="text-muted">@notification.Time.ToString("HH:mm")</small>
										</div>
										<div class="notification-actions d-flex align-items-center">
											@if (!notification.IsRead)
											{
												<div class="unread-indicator me-2"></div>
											}
											<button class="btn btn-sm btn-outline-danger" 
													@onclick:stopPropagation="true"
													@onclick="() => DeleteNotification(notification.Id)"
													title="Sil">
												<i class="fas fa-trash"></i>
											</button>
										</div>
									</div>
								</div>
							}
						</div>
					}
					else
					{
						<div class="text-center py-4">
							<i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
							<p class="text-muted">Henüz bildirim yok</p>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

<!-- Hızlı Hatırlatıcı Modal -->
@if (_showQuickReminderModal)
{
	<div class="modal-backdrop show"></div>
	<div class="modal show d-block" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">
						<i class="fas fa-plus me-2"></i>
						Hızlı Hatırlatıcı
					</h5>
					<button type="button" class="btn-close" @onclick="HideQuickReminderModal"></button>
				</div>
				<div class="modal-body">
					<div class="mb-3">
						<label class="form-label">Başlık</label>
						<input type="text" class="form-control" @bind="_newReminderTitle" placeholder="Hatırlatıcı başlığı..." />
					</div>
					<div class="mb-3">
						<label class="form-label">Mesaj</label>
						<textarea class="form-control" @bind="_newReminderMessage" rows="3" placeholder="Hatırlatıcı mesajı..."></textarea>
					</div>
					<div class="mb-3">
						<label class="form-label">Zaman</label>
						<input type="datetime-local" class="form-control" @bind="_newReminderTime" />
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" @onclick="HideQuickReminderModal">İptal</button>
					<button type="button" class="btn btn-primary" @onclick="SaveQuickReminder">Kaydet</button>
				</div>
			</div>
		</div>
	</div>
}

