		border-radius: 25px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		padding: 12px 20px;
		transition: all 0.3s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: #667eea;
		box-shadow: 0 0 20px rgba(102, 126, 234, 0.3);
		transform: scale(1.02);
