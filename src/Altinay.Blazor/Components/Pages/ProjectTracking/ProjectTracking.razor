	private async Task CheckDailyNotifications()
	{
		var now = DateTime.Now;
		var currentHour = now.Hour;
		var currentMinute = now.Minute;

		// Gün başı bildirimi (9:00)
		if (currentHour == 9 && currentMinute == 0)
		{
			await ShowDailyStartNotification();
		}

		// Gün sonu bildirimi (18:00)
		if (currentHour == 18 && currentMinute == 0)
		{
			await ShowDailyEndNotification();
		}

		// Mola hatırlatıcısı (her 2 saatte bir)
		if (currentHour % 2 == 0 && currentMinute == 0 && currentHour >= 10 && currentHour <= 16)
		{
			await ShowBreakReminder();
		}

		// To-do kontrolü (her saat başı)
		if (currentMinute == 0)
		{
			await CheckTodoOverload();
			await CheckDeadlineNotifications();
			await CheckTeamNotifications();
		}
	}

