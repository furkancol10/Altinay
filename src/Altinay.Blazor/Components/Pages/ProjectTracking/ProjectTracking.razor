		transition: all 0.3s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: #667eea;
		box-shadow: 0 0 20px rgba(102, 126, 234, 0.3);
		transform: scale(1.02);
	}

	.group-by-section {
		display: flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.9);
		padding: 8px 16px;
		border-radius: 20px;
		backdrop-filter: blur(10px);
	}

	.group-by-select {
		width: 150px;
		border: none;
		background: transparent;
		font-weight: 500;
	}

	.sprint-info {
		display: flex;
		align-items: center;
		font-size: 0.9rem;
		background: rgba(255, 193, 7, 0.2);
		padding: 8px 16px;
		border-radius: 20px;
		color: #856404;
		font-weight: 600;
	}

	.project-selector select {
		border-radius: 20px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(10px);
		padding: 8px 16px;
		font-weight: 500;
		transition: all 0.3s ease;
	}

	.project-selector select:focus {
		outline: none;
		border-color: #667eea;
		box-shadow: 0 0 15px rgba(102, 126, 234, 0.3);
	}

	/* Button Styles */
	.btn {
		border-radius: 25px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		transition: all 0.3s ease;
		position: relative;
		overflow: hidden;
	}

	.btn::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
		transition: left 0.5s;
	}

	.btn:hover::before {
		left: 100%;
	}

	.btn-primary {
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		border: none;
		box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
	}

	.btn-success {
		background: linear-gradient(135deg, #56ab2f 0%, #a8e6cf 100%);
		border: none;
		box-shadow: 0 4px 15px rgba(86, 171, 47, 0.4);
	}

	.btn-success:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(86, 171, 47, 0.6);
	}

	.btn-light {
		background: rgba(255, 255, 255, 0.9);
		border: 2px solid rgba(255, 255, 255, 0.3);
		backdrop-filter: blur(10px);
		color: #2c3e50;
	}

	.btn-light:hover {
		background: rgba(255, 255, 255, 1);
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
	}

	/* Drag and Drop Effects - Optimized */
	.column-content.drag-over {
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
		border: 2px dashed #667eea;
		border-radius: 12px;
		transform: scale(1.02);
		transition: transform 0.2s ease, background 0.2s ease; /* Faster transitions */
	}

	.issue-card.dragging {
		opacity: 0.7; /* Less opacity for better performance */
		transform: rotate(3deg) scale(1.03); /* Smaller transform */
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2); /* Lighter shadow */
		z-index: 1000;
		transition: transform 0.15s ease, opacity 0.15s ease; /* Faster transitions */
	}

	.issue-card.drag-over {
		border: 2px solid #667eea;
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
	}

