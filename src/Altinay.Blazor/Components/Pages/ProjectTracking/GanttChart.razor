    // POINTER EVENT C# METHOD'LARI - KAYNAKTAN ENTEGRE
    
    // Bar'ı komple taşıma (drag)
    [JSInvokable]
    public static async Task OnJsDragFinished(string id, double deltaDays)
    {
        try
        {
            if (_currentInstance != null)
            {
                await _currentInstance.OnJsDragFinishedInstance(id, deltaDays);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnJsDragFinished: {ex.Message}");
