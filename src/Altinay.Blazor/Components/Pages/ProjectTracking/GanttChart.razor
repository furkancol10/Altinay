    private async Task OnTaskResizeInstance(string taskId, int widthChange)
    {
        try
        {
            Console.WriteLine($"Task {taskId} resized by {widthChange} pixels");
            
            var task = TaskCollection.FirstOrDefault(t => t.Id == taskId);
            if (task != null)
            {
                // Width change'i gün sayısına çevir - DÜZELTME
                var daysChange = widthChange / 7; // 1 pixel = 7 gün (haftalık görünüm)
                
                // End date'i güncelle
                task.EndDate = task.EndDate.AddDays(daysChange);
                
                // Duration'ı yeniden hesapla
                task.Duration = (int)(task.EndDate - task.StartDate).TotalDays;
                
                Console.WriteLine($"Updated task {task.Task}: Duration = {task.Duration} days, End = {task.EndDate:dd/MM/yyyy}");
                Console.WriteLine($"Width change: {widthChange}px, Days change: {daysChange} days");
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resizing task: {ex.Message}");
        }
    }

