@using Altinay.ProjectTracking.ProjectTrackingDtos
@using Altinay.ProjectTracking.CreateUpdateDtos
@using Altinay.Domain.ProjectTracking
@using Altinay.Enums
@using Altinay.Blazor.Models
@using IssueStatus = Altinay.Domain.ProjectTracking.IssueStatus
@inject IJSRuntime JSRunTime
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper


@code {
    // EVENT CALLBACK - KANBAN ENTEGRASYONU
    [Parameter] public EventCallback<GanttTaskData> OnTaskUpdated { get; set; }
}

<script>
    // POINTER EVENT SİSTEMİ - KAYNAKTAN ENTEGRE
    console.log('POINTER EVENT Sistemi Yükleniyor...');
    
    // State management
    window.ganttState = new Map();
    
    // Options
    window.ganttOptions = {
        pxPerDay: 1 // 1 pixel = 1 gün
    };
    
    // POINTER DOWN - KAYNAKTAN ENTEGRE
    window.onPointerDown = function(e, container, dotnetRef, opts) {
        console.log('POINTER DOWN:', e.target);
        
        const bar = e.target.closest('.task-bar'); // Hangi bar?
        if (!bar) return;
        
        const isResizeLeft = e.target.classList.contains('task-resize-handle') && e.offsetX < 10;
        const isResizeRight = e.target.classList.contains('task-resize-handle') && e.offsetX > 10;
        
        const startX = e.clientX;                   // ilk x
        const startLeft = parseFloat(bar.style.left) || 0;  // barın ilk left'i
        const startWidth = parseFloat(bar.style.width) || 100; // barın ilk width'i
        const id = bar.getAttribute('data-task-id'); // hangi task?
        
        console.log('POINTER DOWN STATE:');
        console.log('Task ID:', id);
        console.log('Start X:', startX);
        console.log('Start Left:', startLeft);
        console.log('Start Width:', startWidth);
        console.log('Is Resize Left:', isResizeLeft);
        console.log('Is Resize Right:', isResizeRight);
        
        window.ganttState.set(container, {
            startX, startLeft, startWidth, id,
            resizing: isResizeLeft ? "left" : (isResizeRight ? "right" : null),
            moving: !isResizeLeft && !isResizeRight
        });
        
        // Visual feedback
        bar.classList.add('dragging');
        bar.style.opacity = '0.7';
    };
    
    // POINTER MOVE - KAYNAKTAN ENTEGRE
    window.onPointerMove = function(e, container, dotnetRef, opts) {
        const ctx = window.ganttState.get(container);
        if (!ctx) return;
        
        const dx = e.clientX - ctx.startX;            // kaç px kaydı
        
        const bar = container.querySelector(`.task-bar[data-task-id="${ctx.id}"]`);
        if (!bar) return;
        
        console.log('POINTER MOVE:');
        console.log('DX:', dx);
        console.log('Moving:', ctx.moving);
        console.log('Resizing:', ctx.resizing);
        
        if (ctx.moving) {
            bar.style.left = `${ctx.startLeft + dx}px`; // tüm barı taşır
        } else if (ctx.resizing === "left") {
            bar.style.left = `${ctx.startLeft + dx}px`;
            bar.style.width = `${ctx.startWidth - dx}px`; // soldan kısalt/uzat
        } else if (ctx.resizing === "right") {
            bar.style.width = `${ctx.startWidth + dx}px`; // sağdan kısalt/uzat
        }
    };
    
    // POINTER UP - KAYNAKTAN ENTEGRE
    window.onPointerUp = function(e, container, dotnetRef, opts) {
        const ctx = window.ganttState.get(container);
        if (!ctx) return;
        
        const dx = e.clientX - ctx.startX;
        const deltaDays = dx / opts.pxPerDay; // px → gün
        
        console.log('POINTER UP:');
        console.log('DX:', dx);
        console.log('Delta Days:', deltaDays);
        console.log('Moving:', ctx.moving);
        console.log('Resizing:', ctx.resizing);
        
        // Remove visual feedback
        const bar = container.querySelector(`.task-bar[data-task-id="${ctx.id}"]`);
        if (bar) {
            bar.classList.remove('dragging');
            bar.style.opacity = '';
        }
        
        // Call C# methods
        try {
            if (ctx.moving) {
                dotnetRef.invokeMethodAsync("OnJsDragFinished", ctx.id, deltaDays);
                console.log('Called OnJsDragFinished');
            } else if (ctx.resizing) {
                dotnetRef.invokeMethodAsync("OnJsResizeFinished", ctx.id, ctx.resizing, deltaDays);
                console.log('Called OnJsResizeFinished');
            }
        } catch (error) {
            console.log('Error calling C# method:', error);
        }
        
        window.ganttState.delete(container);
    };
    
    // DROP - YENİ TEMİZ SİSTEM
    window.handleDrop = function(e) {
        console.log('YENİ Drop:', e.target);
        
        const timelineBody = e.target.closest('.timeline-body');
        if (!timelineBody) {
            console.log('Drop outside timeline - ignoring');
            return;
        }
        
        e.preventDefault();
        timelineBody.classList.remove('drag-over');
        
        // Get task ID
        const taskId = e.dataTransfer.getData('text/plain');
        if (!taskId || !window.draggedTask) {
            console.log('No task data available');
            return;
        }
        
        // Calculate new position - HASSAS HESAPLAMA
        const rect = timelineBody.getBoundingClientRect();
        const mouseX = e.clientX;
        const newPosition = mouseX - rect.left;
        
        // Timeline başlangıç pozisyonunu al (drag start'ta hesaplanan)
        const timelineStartX = window.draggedTask.timelineStartX || 0;
        
        // Clamp position within timeline - HASSAS SINIRLAR
        const minPosition = timelineStartX + 20; // Timeline başlangıcından 20px sonra
        const maxPosition = rect.width - 120; // Timeline sonundan 120px önce
        const clampedPosition = Math.max(minPosition, Math.min(maxPosition, newPosition));
        
        // Calculate days moved - HASSAS HESAPLAMA (1 pixel = 1 gün)
        const pixelsMoved = clampedPosition - window.draggedTask.originalLeft;
        const daysMoved = Math.round(pixelsMoved);
        
        console.log('HASSAS HESAPLAMA:');
        console.log('Mouse X:', mouseX);
        console.log('Timeline rect:', rect);
        console.log('Timeline start X:', timelineStartX);
        console.log('New position:', newPosition);
        console.log('Clamped position:', clampedPosition);
        console.log('Pixels moved:', pixelsMoved);
        console.log('Days moved:', daysMoved);
        
        console.log('Task moved:', daysMoved, 'days');
        console.log('Original position:', window.draggedTask.originalLeft);
        console.log('New position:', clampedPosition);
        
        // Call C# method
        try {
            if (window.DotNet && window.DotNet.invokeMethodAsync) {
                window.DotNet.invokeMethodAsync('Altinay.Blazor', 'OnTaskDateUpdate', taskId, daysMoved);
                console.log('C# method called successfully');
            } else {
                console.log('DotNet interop not available');
            }
        } catch (error) {
            console.log('Error calling C# method:', error);
        }
        
        // Cleanup
        window.draggedTask = null;
        window.isDragging = false;
    };
    
    // Timeline başlangıç pozisyonunu al
    window.getTimelineStartX = function() {
        const timeline = document.querySelector('#timeline-body');
        if (timeline) {
            const rect = timeline.getBoundingClientRect();
            console.log('Timeline start X:', rect.left);
            return Math.floor(rect.left);
        }
        console.log('Timeline not found, returning 300');
        return 300; // Fallback değer
    };
    
    // RESIZE START - YENİ TEMİZ SİSTEM
    window.startResize = function(taskId) {
        console.log('YENİ Resize start for task:', taskId);
        
        const taskBar = document.querySelector(`[data-task-id="${taskId}"]`);
        if (!taskBar) {
            console.log('Task bar not found:', taskId);
            return;
        }
        
        const resizeHandle = taskBar.querySelector('.task-resize-handle');
        if (!resizeHandle) {
            console.log('Resize handle not found');
            return;
        }
        
        // Store original width
        const originalWidth = parseInt(taskBar.style.width) || 100;
        taskBar.setAttribute('data-original-width', originalWidth);
        
        console.log('Original width:', originalWidth);
        
        // Mouse move handler
        const handleMouseMove = (e) => {
            const rect = taskBar.getBoundingClientRect();
            const newWidth = e.clientX - rect.left;
            const minWidth = 20;
            const maxWidth = 400;
            
            if (newWidth >= minWidth && newWidth <= maxWidth) {
                taskBar.style.width = newWidth + 'px';
                console.log('Resizing to:', newWidth);
            }
        };
        
        // Mouse up handler
        const handleMouseUp = () => {
            const finalWidth = parseInt(taskBar.style.width);
            const originalWidth = parseInt(taskBar.getAttribute('data-original-width'));
            const widthChange = finalWidth - originalWidth;
            
            console.log('Resize complete. Width change:', widthChange);
            
            // Call C# method
            try {
                if (window.DotNet && window.DotNet.invokeMethodAsync) {
                    window.DotNet.invokeMethodAsync('Altinay.Blazor', 'OnTaskResize', taskId, widthChange);
                    console.log('C# resize method called successfully');
                } else {
                    console.log('DotNet interop not available for resize');
                }
            } catch (error) {
                console.log('Error calling C# resize method:', error);
            }
            
            // Cleanup
            document.removeEventListener('mousemove', handleMouseMove);
            document.removeEventListener('mouseup', handleMouseUp);
            window.isResizing = false;
        };
        
        // Add event listeners
        document.addEventListener('mousemove', handleMouseMove);
        document.addEventListener('mouseup', handleMouseUp);
        window.isResizing = true;
        
        console.log('Resize listeners added');
    };

    // INIT FUNCTION - KAYNAKTAN ENTEGRE
    window.initGanttPointerEvents = function(container, dotnetRef, opts) {
        console.log('POINTER EVENT Sistemi başlatılıyor...');
        
        // Event'leri bağla
        container.addEventListener("pointerdown", function(e) {
            window.onPointerDown(e, container, dotnetRef, opts);
        });
        
        container.addEventListener("pointermove", function(e) {
            window.onPointerMove(e, container, dotnetRef, opts);
        });
        
        container.addEventListener("pointerup", function(e) {
            window.onPointerUp(e, container, dotnetRef, opts);
        });
        
        console.log('POINTER EVENT Sistemi hazır!');
    };
    
    // Initialize when page loads
    document.addEventListener('DOMContentLoaded', function() {
        console.log('POINTER EVENT Sistemi yüklendi!');
    });
    
    // Temiz sistem - event delegation kullanıyor
</script>

<div class="jira-gantt-container">
    <!-- Header -->
    <div class="gantt-header">
        <div class="header-content">
            <h3 class="header-title">Timeline</h3>
            <div class="header-actions">
                <div class="zoom-controls">
                    <button class="action-btn @(currentZoom == "day" ? "active" : "")" @onclick="@(() => SetZoom("day"))" title="Daily View">
                        <i class="fas fa-calendar-day"></i>
                    </button>
                    <button class="action-btn @(currentZoom == "week" ? "active" : "")" @onclick="@(() => SetZoom("week"))" title="Weekly View">
                        <i class="fas fa-calendar-week"></i>
                    </button>
                    <button class="action-btn @(currentZoom == "month" ? "active" : "")" @onclick="@(() => SetZoom("month"))" title="Monthly View">
                        <i class="fas fa-calendar-alt"></i>
                    </button>
                </div>
                <div class="view-controls">
                    <button class="action-btn primary" title="New Issue" @onclick="@CreateNewIssue">
                        <i class="fas fa-plus"></i>
                        New Issue
                    </button>
                    <button class="action-btn" title="Fit to Screen" @onclick="@FitToScreen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gantt Content -->
    <div class="gantt-content">
        <!-- Left Panel - Task List -->
        <div class="task-panel">
            <div class="task-header">
                <div class="header-row">
                    <span class="task-title">Issues</span>
                    <div class="group-controls">
                        <select class="group-select" @onchange="@OnGroupChange">
                            <option value="none">No Grouping</option>
                            <option value="project">By Project</option>
                            <option value="assignee">By Assignee</option>
                            <option value="status">By Status</option>
                            <option value="epic">By Epic</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="task-list">
                @if (TaskCollection != null && TaskCollection.Any())
                {
                    @if (currentGrouping == "none")
                    {
                        @foreach (var task in TaskCollection)
                        {
                            <div class="task-item" @onclick="@(() => SelectTask(task))">
                                <div class="task-expand">
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                                <div class="task-icon">
                                    <i class="fas fa-bolt" style="color: @GetTaskColor(task);"></i>
                                </div>
                                <div class="task-info">
                                    <div class="task-name">@task.Task</div>
                                    <div class="task-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @task.Progress%; background-color: @GetTaskColor(task);"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var group in GetGroupedTasks())
                        {
                            <div class="task-group">
                                <div class="group-header" @onclick="@(() => ToggleGroup(group.Key))">
                                    <i class="fas fa-chevron-@(expandedGroups.Contains(group.Key) ? "down" : "right")"></i>
                                    <span class="group-title">@group.Key</span>
                                    <span class="group-count">(@group.Value.Count)</span>
                                </div>
                                @if (expandedGroups.Contains(group.Key))
                                {
                                    @foreach (var task in group.Value)
                                    {
                                        <div class="task-item grouped" @onclick="@(() => SelectTask(task))">
                                            <div class="task-expand">
                                                <i class="fas fa-circle" style="font-size: 8px; color: @GetTaskColor(task);"></i>
                                            </div>
                                            <div class="task-icon">
                                                <i class="fas fa-bolt" style="color: @GetTaskColor(task);"></i>
                                            </div>
                                            <div class="task-info">
                                                <div class="task-name">@task.Task</div>
                                                <div class="task-progress">
                                                    <div class="progress-bar">
                                                        <div class="progress-fill" style="width: @task.Progress%; background-color: @GetTaskColor(task);"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-gantt fa-2x"></i>
                        <p>No issues found</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right Panel - Timeline -->
        <div class="timeline-panel">
            <!-- Timeline Header -->
            <div class="timeline-header">
                <div class="timeline-units" style="min-width: @(GetTimelineWidth())px;">
                    @if (currentZoom == "day")
                    {
                        @for (int i = 0; i < 30; i++)
                        {
                            <div class="day-column" style="width: @(dayColumnWidth)px;">
                                <div class="day-name">@DateTime.Now.AddDays(i).ToString("dd")</div>
                                <div class="day-month">@DateTime.Now.AddDays(i).ToString("MMM")</div>
                            </div>
                        }
                    }
                    else if (currentZoom == "week")
                    {
                        @for (int i = 0; i < 12; i++)
                        {
                            <div class="week-column" style="width: @(weekColumnWidth)px;">
                                <div class="week-name">Week @(i + 1)</div>
                                <div class="week-month">@DateTime.Now.AddDays(i * 7).ToString("MMM")</div>
                            </div>
                        }
                    }
                    else
                    {
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="month-column" style="width: @(monthColumnWidth)px;">
                                <div class="month-name">@DateTime.Now.AddMonths(i).ToString("MMM").ToUpper()</div>
                                <div class="sprint-info">
                                    <span class="sprint-label">Sprint @(i + 1)</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Timeline Body -->
            <div id="timeline-body" class="timeline-body">
                @if (TaskCollection != null && TaskCollection.Any())
                {
                    @foreach (var task in TaskCollection)
                    {
                        <div class="timeline-row">
                        <div class="task-bar @(selectedTaskId == task.Id ? "selected" : "")" 
                             style="left: @(GetTaskPosition(task))px; width: @(GetTaskWidth(task))px; background-color: @GetTaskColor(task);"
                             data-task-id="@task.Id"
                             draggable="true"
                             @onclick="@(() => SelectTask(task))"
                             @onclick:stopPropagation="true">
                                <div class="task-bar-content">
                                    <span class="task-label" @onclick="@(() => OnProgressClick(task))" @onclick:stopPropagation="true" style="cursor: pointer;" title="Click to update progress">@task.Progress%</span>
                                    @if (!string.IsNullOrEmpty(task.Dependencies))
                                    {
                                        <i class="fas fa-link dependency-icon" title="Has Dependencies"></i>
                                    }
                                </div>
                                <div class="task-resize-handle" 
                                     title="Drag to resize task duration"></div>
                            </div>
                            
                            <!-- Dependencies Arrows -->
                            @if (!string.IsNullOrEmpty(task.Dependencies))
                            {
                                @foreach (var dependency in GetDependencies(task.Dependencies))
                                {
                                    var depTask = TaskCollection.FirstOrDefault(t => t.Id == dependency.TaskId);
                                    @if (depTask != null)
                                    {
                                        <div class="dependency-arrow @dependency.Type.ToString().ToLower()" 
                                             style="left: @(GetDependencyStartX(depTask, dependency))px; 
                                                    top: @(GetTaskRowPosition(task))px;"
                                             title="@depTask.Task → @task.Task (@dependency.Type)">
                                            <svg width="20" height="20">
                                                <defs>
                                                    <marker id="arrowhead-@dependency.Type" markerWidth="10" markerHeight="7" 
                                                            refX="9" refY="3.5" orient="auto">
                                                        <polygon points="0 0, 10 3.5, 0 7" fill="@GetDependencyColor(dependency.Type)" />
                                                    </marker>
                                                </defs>
                                                <line x1="0" y1="10" x2="20" y2="10" 
                                                      stroke="@GetDependencyColor(dependency.Type)" stroke-width="2" 
                                                      marker-end="url(#arrowhead-@dependency.Type)" />
                                            </svg>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- New Issue Modal -->
<IssueCreateModal @ref="_createModal" OnSaved="OnIssueCreated" />

@code {
    [Parameter] public List<TrackingIssueDto>? Issues { get; set; }
    [Parameter] public EventCallback<TrackingIssueDto> OnTaskSelected { get; set; }
    [Parameter] public EventCallback OnIssueCreated { get; set; }
    
    private IssueCreateModal? _createModal;

    private List<GanttTaskData> TaskCollection = new List<GanttTaskData>();
    private string currentZoom = "week";
    private string selectedTaskId = "";
    private bool isDragging = false;
    private bool isResizing = false;
    private GanttTaskData? draggedTask = null;
    private GanttTaskData? resizedTask = null;
    
    // Grouping
    private string currentGrouping = "none";
    private HashSet<string> expandedGroups = new HashSet<string>();
    
    // Column widths based on zoom level
    private int dayColumnWidth = 30;
    private int weekColumnWidth = 80;
    private int monthColumnWidth = 150;


    private void PrepareGanttData()
    {
        TaskCollection.Clear();
        
        if (Issues != null && Issues.Any())
        {
            foreach (var issue in Issues)
            {
                // StartDate ve EndDate'i doğru hesapla - GERÇEK TARİHLERİ KULLAN
                var startDate = issue.StartDate ?? DateTime.Now.AddDays(new Random().Next(0, 5));
                var endDate = issue.DueDate ?? startDate.AddDays(issue.EstimatedDays);
                
                // Eğer DueDate yoksa, EstimatedDays'e göre hesapla
                if (issue.DueDate == null)
                {
                    endDate = startDate.AddDays(issue.EstimatedDays);
                }
                
                // Tarihleri log'la
                Console.WriteLine($"Task: {issue.Title}, Start: {startDate:dd/MM/yyyy}, End: {endDate:dd/MM/yyyy}, Duration: {(endDate - startDate).Days} days");
                
                TaskCollection.Add(new GanttTaskData
                {
                    Id = issue.Id.ToString(),
                    Task = issue.Title,
                    StartDate = startDate,
                    EndDate = endDate,
                    Duration = (int)(endDate - startDate).TotalDays,
                    Progress = CalculateProgress(issue.Status), // Status'a göre progress hesapla
                    Status = GetStatusText(issue.Status)
                });
            }
        }
        else
        {
            // Örnek veri - farklı uzunluklarda ve status'a göre progress
            TaskCollection.Add(new GanttTaskData
            {
                Id = "1",
                Task = "Kısa Task",
                StartDate = DateTime.Now,
                EndDate = DateTime.Now.AddDays(3),
                Duration = 3,
                Progress = 50, // In Progress = 50%
                Status = "In Progress"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "2",
                Task = "Uzun Task",
                StartDate = DateTime.Now.AddDays(1),
                EndDate = DateTime.Now.AddDays(15),
                Duration = 14,
                Progress = 0, // To Do = 0%
                Status = "To Do"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "3",
                Task = "Orta Task",
                StartDate = DateTime.Now.AddDays(2),
                EndDate = DateTime.Now.AddDays(8),
                Duration = 6,
                Progress = 75, // Review = 75%
                Status = "Review"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "4",
                Task = "Tamamlanan Task",
                StartDate = DateTime.Now.AddDays(3),
                EndDate = DateTime.Now.AddDays(5),
                Duration = 2,
                Progress = 100, // Done = 100%
                Status = "Done"
            });
        }
    }

    private async Task SelectTask(GanttTaskData task)
    {
        selectedTaskId = task.Id;
        StateHasChanged();
        
        // Task seçildiğinde sadece highlight yap, Kanban'a gitme
        Console.WriteLine($"Task selected: {task.Task}");
        
        // Eğer gerçekten Kanban'a gitmek istiyorsan, bu satırı aç:
        // if (Issues != null && Issues.Any())
        // {
        //     var selectedIssue = Issues.FirstOrDefault(i => i.Id.ToString() == task.Id);
        //     if (selectedIssue != null)
        //     {
        //         await OnTaskSelected.InvokeAsync(selectedIssue);
        //     }
        // }
    }

    // BASIT TARİH GÜNCELLEME METHOD'U - DÜZELTME
    [JSInvokable]
    public static async Task OnTaskDateUpdate(string taskId, int daysMoved)
    {
        try
        {
            if (_currentInstance != null)
            {
                await _currentInstance.OnTaskDateUpdateInstance(taskId, daysMoved);
            }
            else
            {
                Console.WriteLine("Current instance is null");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnTaskDateUpdate: {ex.Message}");
        }
    }

    private async Task OnTaskDateUpdateInstance(string taskId, int daysMoved)
    {
        try
        {
            Console.WriteLine($"Task {taskId} moved {daysMoved} days");
            
            var task = TaskCollection.FirstOrDefault(t => t.Id == taskId);
            if (task != null)
            {
                // Update start and end dates - DÜZELTME
                task.StartDate = task.StartDate.AddDays(daysMoved);
                task.EndDate = task.EndDate.AddDays(daysMoved);
                
                // Duration'ı yeniden hesapla
                task.Duration = (int)(task.EndDate - task.StartDate).TotalDays;
                
                Console.WriteLine($"Updated task {task.Task}: {task.StartDate:dd/MM/yyyy} - {task.EndDate:dd/MM/yyyy}");
                Console.WriteLine($"Duration: {task.Duration} days");
                
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task dates: {ex.Message}");
        }
    }

    // PROGRESS GÜNCELLEME - TIKLA VE DEĞİŞTİR
    private async Task OnProgressClick(GanttTaskData task)
    {
        Console.WriteLine($"Progress clicked for task: {task.Task}");
        
        // Progress'i döngüsel olarak güncelle: 0% -> 25% -> 50% -> 75% -> 100% -> 0%
        task.Progress = task.Progress switch
        {
