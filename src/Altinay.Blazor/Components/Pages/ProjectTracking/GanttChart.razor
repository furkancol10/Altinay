    private async Task UpdateTaskPosition(GanttTaskData task, int newPosition)
    {
        try
        {
            Console.WriteLine($"Updating task {task.Task} to position {newPosition}");
            
            // Pixel'i gün olarak çevir - daha doğru hesaplama
            var daysPerPixel = GetDaysPerPixel(); // Timeline zoom'a göre dinamik
            var daysToAdd = newPosition * daysPerPixel;
            
            // Task'ın mevcut süresini koru
            var duration = (task.EndDate - task.StartDate).Days;
            
            // Yeni başlangıç tarihi hesapla - timeline'ın başlangıcından itibaren
            var timelineStartDate = GetTimelineStartDate();
            var newStartDate = timelineStartDate.AddDays(daysToAdd);
            var newEndDate = newStartDate.AddDays(duration);
            
            // Task'ı güncelle
            task.StartDate = newStartDate;
            task.EndDate = newEndDate;
            
            Console.WriteLine($"Task {task.Task} new dates: {task.StartDate:dd/MM/yyyy} - {task.EndDate:dd/MM/yyyy}");
            Console.WriteLine($"Days per pixel: {daysPerPixel}, Days to add: {daysToAdd}");
            
            // Database'i güncelle (placeholder)
            await UpdateTaskInDatabase(task);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task position: {ex.Message}");
        }
    }

    private DateTime GetTimelineStartDate()
    {
        // Timeline'ın başlangıç tarihi - şu anki tarihten 30 gün önce
        return DateTime.Now.AddDays(-30);
    }

    private DateTime CalculateDateFromPosition(int position)
    {
        // Timeline'daki pozisyonu tarihe çevir
        var daysPerPixel = GetDaysPerPixel();
        var daysFromStart = position / daysPerPixel;
        var timelineStart = GetTimelineStartDate();
        
        return timelineStart.AddDays(daysFromStart);
    }

    private double GetDaysPerPixel()
    {
        return currentZoom switch
        {
            "day" => 1.0 / dayColumnWidth,
            "week" => 7.0 / weekColumnWidth,
            "month" => 30.0 / monthColumnWidth,
            _ => 1.0 / dayColumnWidth
        };
    }

