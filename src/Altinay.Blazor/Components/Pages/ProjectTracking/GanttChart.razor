    // Dependencies Functions
    private List<DependencyModel> GetDependencies(string dependencies)
    {
        if (string.IsNullOrEmpty(dependencies))
            return new List<DependencyModel>();
        
        var result = new List<DependencyModel>();
        var depStrings = dependencies.Split(',');
        
        foreach (var depString in depStrings)
        {
            var parts = depString.Trim().Split(':');
            var taskId = parts[0];
            var type = parts.Length > 1 ? parts[1] : "FS";
            
            result.Add(new DependencyModel
            {
                TaskId = taskId,
                Type = GetDependencyType(type)
            });
        }
        
        return result;
    }

    private DependencyType GetDependencyType(string type)
    {
        return type.ToUpper() switch
        {
            "FS" => DependencyType.FinishToStart,
            "SS" => DependencyType.StartToStart,
            "FF" => DependencyType.FinishToFinish,
            "SF" => DependencyType.StartToFinish,
            _ => DependencyType.FinishToStart
        };
    }

    private int GetDependencyStartX(GanttTaskData depTask, DependencyModel dependency)
    {
        return dependency.Type switch
        {
            DependencyType.FinishToStart => GetTaskPosition(depTask) + GetTaskWidth(depTask),
            DependencyType.StartToStart => GetTaskPosition(depTask),
            DependencyType.FinishToFinish => GetTaskPosition(depTask) + GetTaskWidth(depTask),
            DependencyType.StartToFinish => GetTaskPosition(depTask),
            _ => GetTaskPosition(depTask) + GetTaskWidth(depTask)
        };
    }

    private string GetDependencyColor(DependencyType type)
    {
        return type switch
        {
            DependencyType.FinishToStart => "#0052CC",  // Mavi
            DependencyType.StartToStart => "#36B37E",   // Yeşil
            DependencyType.FinishToFinish => "#FFAB00", // Sarı
            DependencyType.StartToFinish => "#FF5630",   // Kırmızı
            _ => "#0052CC"
        };
    }

