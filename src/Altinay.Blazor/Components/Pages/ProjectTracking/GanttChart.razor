@using Altinay.ProjectTracking.ProjectTrackingDtos
@using Altinay.Domain.ProjectTracking
@using Altinay.Enums
@inject IJSRuntime JSRunTime
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper

<script>
    // Kanban'dan kopyalanan tam drag drop sistemi
    console.log('Gantt Chart JavaScript loaded');
    
    // Global variables
    window.draggedTaskId = null;
    window.ganttDragDropInitialized = false;
    
    // Kanban'daki gibi dragged task'ı set et
    window.setDraggedTask = function(taskId) {
        console.log('setDraggedTask called with:', taskId);
        window.draggedTaskId = taskId;
    };
    
    // Kanban'daki gibi drag drop setup
    window.setupGanttDragAndDrop = () => {
        if (window.ganttDragDropInitialized) {
            console.log('Gantt drag and drop already initialized');
            return;
        }
        
        console.log('Setting up Gantt drag and drop...');
        
        // Remove existing listeners to prevent duplicates
        document.removeEventListener('dragstart', handleGanttDragStart);
        document.removeEventListener('dragend', handleGanttDragEnd);
        document.removeEventListener('dragover', handleGanttDragOver);
        document.removeEventListener('drop', handleGanttDrop);
        
        // Add event delegation listeners
        document.addEventListener('dragstart', handleGanttDragStart, true);
        document.addEventListener('dragend', handleGanttDragEnd, true);
        document.addEventListener('dragover', handleGanttDragOver, true);
        document.addEventListener('drop', handleGanttDrop, true);
        
        window.ganttDragDropInitialized = true;
        console.log('Gantt drag and drop setup complete');
    };
    
    // Event handlers with event delegation
    function handleGanttDragStart(e) {
        if (!e.target.classList.contains('task-bar')) return;
        
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', ''); // Required for Firefox
        
        // Add visual feedback
        e.target.classList.add('dragging');
        
        // Store the dragged task ID
        const taskId = e.target.getAttribute('data-task-id');
        if (taskId) {
            window.draggedTaskId = taskId;
            console.log('Dragging task:', taskId);
        }
    }
    
    function handleGanttDragEnd(e) {
        if (!e.target.classList.contains('task-bar')) return;
        
        // Remove visual feedback
        e.target.classList.remove('dragging');
    }
    
    function handleGanttDragOver(e) {
        if (!e.target.classList.contains('timeline-body')) return;
        
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        e.target.classList.add('drag-over');
    }
    
    // Debounced drop handler
    let ganttDropTimeout;
    function handleGanttDrop(e) {
        if (!e.target.classList.contains('timeline-body')) return;
        
        e.preventDefault();
        e.target.classList.remove('drag-over');
        
        // Debounce to prevent multiple calls
        clearTimeout(ganttDropTimeout);
        ganttDropTimeout = setTimeout(() => {
            if (window.draggedTaskId && window.DotNet) {
                console.log('Dropping task:', window.draggedTaskId);
                
                try {
                    // Calculate new position
                    const rect = e.target.getBoundingClientRect();
                    const mouseX = e.clientX;
                    const relativeX = mouseX - rect.left;
                    
                    console.log('Drop position:', relativeX);
                    
                    // Call C# method
                    window.DotNet.invokeMethodAsync('Altinay.Blazor', 'OnGanttDrop', window.draggedTaskId, relativeX);
                } catch (err) {
                    console.error('Error calling OnGanttDrop:', err);
                }
            }
        }, 50); // 50ms debounce
    }
    
    // Timeline başlangıç pozisyonunu al
    window.getTimelineStartX = function() {
        const timeline = document.querySelector('#timeline-body');
        if (timeline) {
            const rect = timeline.getBoundingClientRect();
            console.log('Timeline start X:', rect.left);
            return Math.floor(rect.left);
        }
        console.log('Timeline not found, returning 300');
        return 300; // Fallback değer
    };
    
    // Resize listener fonksiyonu
    window.addResizeListener = function(taskId) {
        console.log('Resize listener added for task:', taskId);
        
        // Resize handle'a event listener ekle
        const resizeHandle = document.querySelector(`[data-task-id="${taskId}"] .task-resize-handle`);
        if (resizeHandle) {
            resizeHandle.addEventListener('mousedown', function(e) {
                e.preventDefault();
                console.log('Resize handle clicked for task:', taskId);
                
                // Resize işlemi burada yapılabilir
                // Şimdilik sadece log
            });
        }
    };
    
    // Initialize drag and drop when page loads
    document.addEventListener('DOMContentLoaded', function() {
        window.setupGanttDragAndDrop();
    });
</script>

<div class="jira-gantt-container">
    <!-- Header -->
    <div class="gantt-header">
        <div class="header-content">
            <h3 class="header-title">Timeline</h3>
            <div class="header-actions">
                <div class="zoom-controls">
                    <button class="action-btn @(currentZoom == "day" ? "active" : "")" @onclick="@(() => SetZoom("day"))" title="Daily View">
                        <i class="fas fa-calendar-day"></i>
                    </button>
                    <button class="action-btn @(currentZoom == "week" ? "active" : "")" @onclick="@(() => SetZoom("week"))" title="Weekly View">
                        <i class="fas fa-calendar-week"></i>
                    </button>
                    <button class="action-btn @(currentZoom == "month" ? "active" : "")" @onclick="@(() => SetZoom("month"))" title="Monthly View">
                        <i class="fas fa-calendar-alt"></i>
                    </button>
                </div>
                <div class="view-controls">
                    <button class="action-btn primary" title="New Issue" @onclick="@CreateNewIssue">
                        <i class="fas fa-plus"></i>
                        New Issue
                    </button>
                    <button class="action-btn" title="Fit to Screen" @onclick="@FitToScreen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Gantt Content -->
    <div class="gantt-content">
        <!-- Left Panel - Task List -->
        <div class="task-panel">
            <div class="task-header">
                <div class="header-row">
                    <span class="task-title">Issues</span>
                    <div class="group-controls">
                        <select class="group-select" @onchange="@OnGroupChange">
                            <option value="none">No Grouping</option>
                            <option value="project">By Project</option>
                            <option value="assignee">By Assignee</option>
                            <option value="status">By Status</option>
                            <option value="epic">By Epic</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="task-list">
                @if (TaskCollection != null && TaskCollection.Any())
                {
                    @if (currentGrouping == "none")
                    {
                        @foreach (var task in TaskCollection)
                        {
                            <div class="task-item" @onclick="@(() => SelectTask(task))">
                                <div class="task-expand">
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                                <div class="task-icon">
                                    <i class="fas fa-bolt" style="color: @GetTaskColor(task);"></i>
                                </div>
                                <div class="task-info">
                                    <div class="task-name">@task.Task</div>
                                    <div class="task-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @task.Progress%; background-color: @GetTaskColor(task);"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var group in GetGroupedTasks())
                        {
                            <div class="task-group">
                                <div class="group-header" @onclick="@(() => ToggleGroup(group.Key))">
                                    <i class="fas fa-chevron-@(expandedGroups.Contains(group.Key) ? "down" : "right")"></i>
                                    <span class="group-title">@group.Key</span>
                                    <span class="group-count">(@group.Value.Count)</span>
                                </div>
                                @if (expandedGroups.Contains(group.Key))
                                {
                                    @foreach (var task in group.Value)
                                    {
                                        <div class="task-item grouped" @onclick="@(() => SelectTask(task))">
                                            <div class="task-expand">
                                                <i class="fas fa-circle" style="font-size: 8px; color: @GetTaskColor(task);"></i>
                                            </div>
                                            <div class="task-icon">
                                                <i class="fas fa-bolt" style="color: @GetTaskColor(task);"></i>
                                            </div>
                                            <div class="task-info">
                                                <div class="task-name">@task.Task</div>
                                                <div class="task-progress">
                                                    <div class="progress-bar">
                                                        <div class="progress-fill" style="width: @task.Progress%; background-color: @GetTaskColor(task);"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-gantt fa-2x"></i>
                        <p>No issues found</p>
                    </div>
                }
            </div>
        </div>

        <!-- Right Panel - Timeline -->
        <div class="timeline-panel">
            <!-- Timeline Header -->
            <div class="timeline-header">
                <div class="timeline-units" style="min-width: @(GetTimelineWidth())px;">
                    @if (currentZoom == "day")
                    {
                        @for (int i = 0; i < 30; i++)
                        {
                            <div class="day-column" style="width: @(dayColumnWidth)px;">
                                <div class="day-name">@DateTime.Now.AddDays(i).ToString("dd")</div>
                                <div class="day-month">@DateTime.Now.AddDays(i).ToString("MMM")</div>
                            </div>
                        }
                    }
                    else if (currentZoom == "week")
                    {
                        @for (int i = 0; i < 12; i++)
                        {
                            <div class="week-column" style="width: @(weekColumnWidth)px;">
                                <div class="week-name">Week @(i + 1)</div>
                                <div class="week-month">@DateTime.Now.AddDays(i * 7).ToString("MMM")</div>
                            </div>
                        }
                    }
                    else
                    {
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="month-column" style="width: @(monthColumnWidth)px;">
                                <div class="month-name">@DateTime.Now.AddMonths(i).ToString("MMM").ToUpper()</div>
                                <div class="sprint-info">
                                    <span class="sprint-label">Sprint @(i + 1)</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Timeline Body -->
            <div id="timeline-body" class="timeline-body" 
                 @ondragover:preventDefault
                 @ondrop="@OnTimelineDrop"
                 @ondragenter="@OnTimelineDragEnter">
                @if (TaskCollection != null && TaskCollection.Any())
                {
                    @foreach (var task in TaskCollection)
                    {
                        <div class="timeline-row">
                        <div class="task-bar @(selectedTaskId == task.Id ? "selected" : "")" 
                             style="left: @(GetTaskPosition(task))px; width: @(GetTaskWidth(task))px; background-color: @GetTaskColor(task);"
                             data-task-id="@task.Id"
                             draggable="true"
                             @ondragstart="@(() => HandleDragStart(task))"
                             @ondragend="@HandleDragEnd"
                             @onclick="@(() => SelectTask(task))"
                             @onclick:stopPropagation="true">
                                <div class="task-bar-content">
                                    <span class="task-label">@task.Progress%</span>
                                    @if (!string.IsNullOrEmpty(task.Dependencies))
                                    {
                                        <i class="fas fa-link dependency-icon" title="Has Dependencies"></i>
                                    }
                                </div>
                                <div class="task-resize-handle" @onmousedown="@(() => OnResizeStart(task))"></div>
                            </div>
                            
                            <!-- Dependencies Arrows -->
                            @if (!string.IsNullOrEmpty(task.Dependencies))
                            {
                                @foreach (var dependency in GetDependencies(task.Dependencies))
                                {
                                    var depTask = TaskCollection.FirstOrDefault(t => t.Id == dependency.TaskId);
                                    @if (depTask != null)
                                    {
                                        <div class="dependency-arrow @dependency.Type.ToString().ToLower()" 
                                             style="left: @(GetDependencyStartX(depTask, dependency))px; 
                                                    top: @(GetTaskRowPosition(task))px;"
                                             title="@depTask.Task → @task.Task (@dependency.Type)">
                                            <svg width="20" height="20">
                                                <defs>
                                                    <marker id="arrowhead-@dependency.Type" markerWidth="10" markerHeight="7" 
                                                            refX="9" refY="3.5" orient="auto">
                                                        <polygon points="0 0, 10 3.5, 0 7" fill="@GetDependencyColor(dependency.Type)" />
                                                    </marker>
                                                </defs>
                                                <line x1="0" y1="10" x2="20" y2="10" 
                                                      stroke="@GetDependencyColor(dependency.Type)" stroke-width="2" 
                                                      marker-end="url(#arrowhead-@dependency.Type)" />
                                            </svg>
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- New Issue Modal -->
<IssueCreateModal @ref="_createModal" OnSaved="OnIssueCreated" />

@code {
    [Parameter] public List<TrackingIssueDto>? Issues { get; set; }
    [Parameter] public EventCallback<TrackingIssueDto> OnTaskSelected { get; set; }
    [Parameter] public EventCallback OnIssueCreated { get; set; }
    
    private IssueCreateModal? _createModal;

    private List<GanttTaskData> TaskCollection = new List<GanttTaskData>();
    private string currentZoom = "week";
    private string selectedTaskId = "";
    private bool isDragging = false;
    private bool isResizing = false;
    private GanttTaskData? draggedTask = null;
    private GanttTaskData? resizedTask = null;
    
    // Grouping
    private string currentGrouping = "none";
    private HashSet<string> expandedGroups = new HashSet<string>();
    
    // Column widths based on zoom level
    private int dayColumnWidth = 30;
    private int weekColumnWidth = 80;
    private int monthColumnWidth = 150;

    protected override void OnInitialized()
    {
        PrepareGanttData();
    }

    private void PrepareGanttData()
    {
        TaskCollection.Clear();
        
        if (Issues != null && Issues.Any())
        {
            foreach (var issue in Issues)
            {
                // StartDate ve EndDate'i doğru hesapla - GERÇEK TARİHLERİ KULLAN
                var startDate = issue.StartDate ?? DateTime.Now.AddDays(new Random().Next(0, 5));
                var endDate = issue.DueDate ?? startDate.AddDays(issue.EstimatedDays);
                
                // Eğer DueDate yoksa, EstimatedDays'e göre hesapla
                if (issue.DueDate == null)
                {
                    endDate = startDate.AddDays(issue.EstimatedDays);
                }
                
                // Tarihleri log'la
                Console.WriteLine($"Task: {issue.Title}, Start: {startDate:dd/MM/yyyy}, End: {endDate:dd/MM/yyyy}, Duration: {(endDate - startDate).Days} days");
                
                TaskCollection.Add(new GanttTaskData
                {
                    Id = issue.Id.ToString(),
                    Task = issue.Title,
                    StartDate = startDate,
                    EndDate = endDate,
                    Duration = (int)(endDate - startDate).TotalDays,
                    Progress = CalculateProgress(issue.Status), // Status'a göre progress hesapla
                    Status = GetStatusText(issue.Status)
                });
            }
        }
        else
        {
            // Örnek veri - farklı uzunluklarda ve status'a göre progress
            TaskCollection.Add(new GanttTaskData
            {
                Id = "1",
                Task = "Kısa Task",
                StartDate = DateTime.Now,
                EndDate = DateTime.Now.AddDays(3),
                Duration = 3,
                Progress = 50, // In Progress = 50%
                Status = "In Progress"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "2",
                Task = "Uzun Task",
                StartDate = DateTime.Now.AddDays(1),
                EndDate = DateTime.Now.AddDays(15),
                Duration = 14,
                Progress = 0, // To Do = 0%
                Status = "To Do"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "3",
                Task = "Orta Task",
                StartDate = DateTime.Now.AddDays(2),
                EndDate = DateTime.Now.AddDays(8),
                Duration = 6,
                Progress = 75, // Review = 75%
                Status = "Review"
            });
            
            TaskCollection.Add(new GanttTaskData
            {
                Id = "4",
                Task = "Tamamlanan Task",
                StartDate = DateTime.Now.AddDays(3),
                EndDate = DateTime.Now.AddDays(5),
                Duration = 2,
                Progress = 100, // Done = 100%
                Status = "Done"
            });
        }
    }

    private async Task SelectTask(GanttTaskData task)
    {
        selectedTaskId = task.Id;
        StateHasChanged();
        
        // Task seçildiğinde sadece highlight yap, Kanban'a gitme
        Console.WriteLine($"Task selected: {task.Task}");
        
        // Eğer gerçekten Kanban'a gitmek istiyorsan, bu satırı aç:
        // if (Issues != null && Issues.Any())
        // {
        //     var selectedIssue = Issues.FirstOrDefault(i => i.Id.ToString() == task.Id);
        //     if (selectedIssue != null)
        //     {
        //         await OnTaskSelected.InvokeAsync(selectedIssue);
        //     }
        // }
    }

    private string GetStatusText(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.ToDo => "To Do",
            IssueStatus.InProgress => "In Progress",
            IssueStatus.InReview => "In Review",
            IssueStatus.Done => "Done",
            _ => "To Do"
        };
    }

    private string GetTaskColor(GanttTaskData task)
    {
        return task.Status switch
        {
            "Done" => "#36B37E",
            "In Progress" => "#0052CC",
            "In Review" => "#FFAB00",
            _ => "#5E6C84"
        };
    }

    private int GetTaskPosition(GanttTaskData task)
    {
        var daysDiff = (task.StartDate - DateTime.Now).Days;
        return Math.Max(0, daysDiff * 30); // 30px per day
    }

    private int GetTaskWidth(GanttTaskData task)
    {
        var columnWidth = currentZoom switch
        {
            "day" => dayColumnWidth,
            "week" => weekColumnWidth,
            _ => monthColumnWidth
        };
        
        // Duration'ı StartDate ve EndDate'den hesapla
        var actualDuration = (task.EndDate - task.StartDate).Days;
        
        var durationInUnits = currentZoom switch
        {
            "day" => Math.Max(1, actualDuration),
            "week" => Math.Max(1, actualDuration / 7),
            _ => Math.Max(1, actualDuration / 30)
        };
        
        return durationInUnits * columnWidth;
    }

    // Zoom Functions
    private void SetZoom(string zoom)
    {
        currentZoom = zoom;
        StateHasChanged();
    }

    private void FitToScreen()
    {
        // Auto-fit logic
        currentZoom = "week";
        StateHasChanged();
    }

    private int GetTimelineWidth()
    {
        return currentZoom switch
        {
            "day" => 30 * dayColumnWidth,
            "week" => 12 * weekColumnWidth,
            _ => 6 * monthColumnWidth
        };
    }

    // Drag & Drop Functions (Kanban'dan kopyalandı)
    private async Task HandleDragStart(GanttTaskData task)
    {
        draggedTask = task;
        isDragging = true;
        selectedTaskId = task.Id;
        Console.WriteLine($"Drag started for task: {task.Task}");
        
        // Kanban'daki gibi JavaScript'e gönder
        await JSRunTime.InvokeVoidAsync("setDraggedTask", task.Id);
    }

    [JSInvokable]
    public static async Task OnGanttDrop(string taskId, double relativeX)
    {
        // Get the current component instance
        var component = GetCurrentComponent();
        if (component != null)
        {
            await component.OnGanttDropInstance(taskId, relativeX);
        }
    }

    public async Task OnGanttDropInstance(string taskId, double relativeX)
    {
        try
        {
            Console.WriteLine($"OnGanttDrop called: taskId={taskId}, relativeX={relativeX}");
            
            // Find the task
            var task = TaskCollection.FirstOrDefault(t => t.Id == taskId);
            if (task != null)
            {
                // Update task position
                await UpdateTaskPosition(task, (int)relativeX);
                Console.WriteLine($"Task {task.Task} moved to position {relativeX}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnGanttDrop: {ex.Message}");
        }
    }

    private static GanttChart? _currentInstance;
    
    public static GanttChart? GetCurrentComponent()
    {
        return _currentInstance;
    }

    protected override async Task OnInitializedAsync()
    {
        _currentInstance = this;
        PrepareGanttData();
        await JSRunTime.InvokeVoidAsync("setupGanttDragAndDrop");
    }

    private async Task HandleDragEnd(DragEventArgs e)
    {
        isDragging = false;
        draggedTask = null;
        Console.WriteLine("Drag ended");
        
        // Drag end işlemi burada yapılabilir
        await Task.CompletedTask;
    }

    private async Task OnTimelineDragOver(DragEventArgs e)
    {
        // PreventDefault() yok, sadece log
        Console.WriteLine("Drag over timeline");
        await Task.CompletedTask;
    }

    private async Task OnTimelineDragEnter(DragEventArgs e)
    {
        // PreventDefault() yok, sadece log
        Console.WriteLine("Drag entered timeline");
        await Task.CompletedTask;
    }

    private async Task OnTimelineDrop(DragEventArgs e)
    {
        // PreventDefault() yok, sadece log
        Console.WriteLine($"OnTimelineDrop called, draggedTask: {draggedTask?.Task}");
        
        if (draggedTask != null)
        {
            try
            {
                // Mouse pozisyonunu al
                var mouseX = e.ClientX;
                Console.WriteLine($"Drop at mouse X: {mouseX}");
                
                // Timeline'ın gerçek başlangıç pozisyonunu hesapla
                var timelineStart = await JSRunTime.InvokeAsync<int>("getTimelineStartX");
                var relativeX = mouseX - timelineStart;
                
                Console.WriteLine($"Timeline start: {timelineStart}, Relative X: {relativeX}");
                
                if (relativeX > 0)
                {
                    // Task'ın pozisyonunu güncelle
                    await UpdateTaskPosition(draggedTask, (int)relativeX);
                    Console.WriteLine($"Task {draggedTask.Task} moved to position {relativeX}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error updating task position: {ex.Message}");
            }
        }
        
        draggedTask = null;
        StateHasChanged();
    }

    private async Task<int?> CalculateNewTaskPosition(int mouseX)
    {
        try
        {
            // Timeline'ın başlangıç pozisyonunu al
            var timelineStart = await JSRunTime.InvokeAsync<int>("getTimelineStartX");
            var relativeX = mouseX - timelineStart;
            
            Console.WriteLine($"Mouse X: {mouseX}, Timeline Start: {timelineStart}, Relative X: {relativeX}");
            
            // Pozitif ise timeline içinde
            if (relativeX >= 0)
            {
                return relativeX;
            }
            
            return null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"CalculateNewTaskPosition error: {ex.Message}");
            return null;
        }
    }

    private async Task UpdateTaskPosition(GanttTaskData task, int newPosition)
    {
        try
        {
            Console.WriteLine($"Updating task {task.Task} to position {newPosition}");
            
            // Pixel'i gün olarak çevir - daha doğru hesaplama
            var daysPerPixel = GetDaysPerPixel(); // Timeline zoom'a göre dinamik
            var daysToAdd = newPosition * daysPerPixel;
            
            // Task'ın mevcut süresini koru
            var duration = (task.EndDate - task.StartDate).Days;
            
            // Yeni başlangıç tarihi hesapla - timeline'ın başlangıcından itibaren
            var timelineStartDate = GetTimelineStartDate();
            var newStartDate = timelineStartDate.AddDays(daysToAdd);
            var newEndDate = newStartDate.AddDays(duration);
            
            // Task'ı güncelle
            task.StartDate = newStartDate;
            task.EndDate = newEndDate;
            
            Console.WriteLine($"Task {task.Task} new dates: {task.StartDate:dd/MM/yyyy} - {task.EndDate:dd/MM/yyyy}");
            Console.WriteLine($"Days per pixel: {daysPerPixel}, Days to add: {daysToAdd}");
            
            // Database'i güncelle (placeholder)
            await UpdateTaskInDatabase(task);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task position: {ex.Message}");
        }
    }

    private DateTime GetTimelineStartDate()
    {
        // Timeline'ın başlangıç tarihi - şu anki tarihten 30 gün önce
        return DateTime.Now.AddDays(-30);
    }

    private DateTime CalculateDateFromPosition(int position)
    {
        // Timeline'daki pozisyonu tarihe çevir
        var daysPerPixel = GetDaysPerPixel();
        var daysFromStart = position / daysPerPixel;
        var timelineStart = GetTimelineStartDate();
        
        return timelineStart.AddDays(daysFromStart);
    }

    private double GetDaysPerPixel()
    {
        return currentZoom switch
        {
            "day" => 1.0 / dayColumnWidth,
            "week" => 7.0 / weekColumnWidth,
            "month" => 30.0 / monthColumnWidth,
            _ => 1.0 / dayColumnWidth
        };
    }

    private void OnTaskMouseDown(GanttTaskData task)
    {
        selectedTaskId = task.Id;
        StateHasChanged();
    }

    private async Task OnResizeStart(GanttTaskData task)
    {
        resizedTask = task;
        isResizing = true;
        Console.WriteLine($"Resize started for task: {task.Task}");
        
        // Resize işlemi için JavaScript event listener ekle - HATA DÜZELTİLDİ
        try
        {
            await JSRunTime.InvokeVoidAsync("addResizeListener", task.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"JavaScript error: {ex.Message}");
        }
        
        await Task.CompletedTask;
    }

    // Progress Calculation based on Status
    private int CalculateProgress(IssueStatus status)
    {
        return status switch
        {
            IssueStatus.ToDo => 0,
            IssueStatus.InProgress => 50,
            IssueStatus.InReview => 75,
            IssueStatus.Done => 100,
            _ => 0
        };
    }

    // Update Task in Database (Placeholder for future implementation)
    private async Task UpdateTaskInDatabase(GanttTaskData task)
    {
        // TODO: Implement database update when service is available
        await Task.CompletedTask;
        Console.WriteLine($"Task updated: {task.Task}");
    }

    private IssueStatus GetStatusFromText(string statusText)
    {
        return statusText switch
        {
            "To Do" => IssueStatus.ToDo,
            "In Progress" => IssueStatus.InProgress,
            "In Review" => IssueStatus.InReview,
            "Done" => IssueStatus.Done,
            _ => IssueStatus.ToDo
        };
    }

    // Dependencies Functions
    private List<DependencyModel> GetDependencies(string dependencies)
    {
        if (string.IsNullOrEmpty(dependencies))
            return new List<DependencyModel>();
        
        var result = new List<DependencyModel>();
        var depStrings = dependencies.Split(',');
        
        foreach (var depString in depStrings)
        {
            var parts = depString.Trim().Split(':');
            var taskId = parts[0];
            var type = parts.Length > 1 ? parts[1] : "FS";
            
            result.Add(new DependencyModel
            {
                TaskId = taskId,
                Type = GetDependencyType(type)
            });
        }
        
        return result;
    }

    private DependencyType GetDependencyType(string type)
    {
        return type.ToUpper() switch
        {
            "FS" => DependencyType.FinishToStart,
            "SS" => DependencyType.StartToStart,
            "FF" => DependencyType.FinishToFinish,
            "SF" => DependencyType.StartToFinish,
            _ => DependencyType.FinishToStart
        };
    }

    private int GetDependencyStartX(GanttTaskData depTask, DependencyModel dependency)
    {
        return dependency.Type switch
        {
            DependencyType.FinishToStart => GetTaskPosition(depTask) + GetTaskWidth(depTask),
            DependencyType.StartToStart => GetTaskPosition(depTask),
            DependencyType.FinishToFinish => GetTaskPosition(depTask) + GetTaskWidth(depTask),
            DependencyType.StartToFinish => GetTaskPosition(depTask),
            _ => GetTaskPosition(depTask) + GetTaskWidth(depTask)
        };
    }

    private string GetDependencyColor(DependencyType type)
    {
        return type switch
        {
            DependencyType.FinishToStart => "#0052CC",  // Mavi
            DependencyType.StartToStart => "#36B37E",   // Yeşil
            DependencyType.FinishToFinish => "#FFAB00", // Sarı
            DependencyType.StartToFinish => "#FF5630",   // Kırmızı
            _ => "#0052CC"
        };
    }

    private int GetTaskRowPosition(GanttTaskData task)
    {
        var index = TaskCollection.IndexOf(task);
        return index * 40; // 40px per row
    }

    // Grouping Functions
    private void OnGroupChange(ChangeEventArgs e)
    {
        currentGrouping = e.Value?.ToString() ?? "none";
        expandedGroups.Clear();
        StateHasChanged();
    }

    private void ToggleGroup(string groupKey)
    {
        if (expandedGroups.Contains(groupKey))
            expandedGroups.Remove(groupKey);
        else
            expandedGroups.Add(groupKey);
        
        StateHasChanged();
    }

    private Dictionary<string, List<GanttTaskData>> GetGroupedTasks()
    {
        if (currentGrouping == "none")
            return new Dictionary<string, List<GanttTaskData>>();

        return currentGrouping switch
        {
            "project" => TaskCollection.GroupBy(t => t.Category ?? "No Project").ToDictionary(g => g.Key, g => g.ToList()),
            "assignee" => TaskCollection.GroupBy(t => t.Assignee ?? "Unassigned").ToDictionary(g => g.Key, g => g.ToList()),
            "status" => TaskCollection.GroupBy(t => t.Status).ToDictionary(g => g.Key, g => g.ToList()),
            "epic" => TaskCollection.GroupBy(t => t.Initiative ?? "No Epic").ToDictionary(g => g.Key, g => g.ToList()),
            _ => new Dictionary<string, List<GanttTaskData>>()
        };
    }

    // Overdue Detection
    private bool IsOverdue(GanttTaskData task)
    {
        return task.EndDate < DateTime.Now && task.Status != "Done";
    }

    private bool IsNearDeadline(GanttTaskData task)
    {
        var daysUntilDeadline = (task.EndDate - DateTime.Now).Days;
        return daysUntilDeadline <= 3 && daysUntilDeadline >= 0 && task.Status != "Done";
    }

    // Critical Path Detection (Simplified)
    private bool IsCriticalPath(GanttTaskData task)
    {
        // Simplified: Tasks with dependencies are considered critical
        return !string.IsNullOrEmpty(task.Dependencies);
    }

    // New Issue Creation
    private async Task CreateNewIssue()
    {
        if (_createModal != null)
        {
            await _createModal.ShowAsync();
        }
    }
}

