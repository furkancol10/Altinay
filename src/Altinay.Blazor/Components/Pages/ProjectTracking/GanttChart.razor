    private Dictionary<string, List<GanttTaskData>> GetGroupedTasks()
    {
        if (currentGrouping == "none")
            return new Dictionary<string, List<GanttTaskData>>();

        return currentGrouping switch
        {
            "project" => TaskCollection.GroupBy(t => t.Category ?? "No Project").ToDictionary(g => g.Key, g => g.ToList()),
            "assignee" => TaskCollection.GroupBy(t => t.Assignee ?? "Unassigned").ToDictionary(g => g.Key, g => g.ToList()),
            "status" => TaskCollection.GroupBy(t => t.Status).ToDictionary(g => g.Key, g => g.ToList()),
            "epic" => TaskCollection.GroupBy(t => t.Initiative ?? "No Epic").ToDictionary(g => g.Key, g => g.ToList()),
            _ => new Dictionary<string, List<GanttTaskData>>()
        };
    }

    // Overdue Detection
    private bool IsOverdue(GanttTaskData task)
    {
        return task.EndDate < DateTime.Now && task.Status != "Done";
    }

    private bool IsNearDeadline(GanttTaskData task)
    {
        var daysUntilDeadline = (task.EndDate - DateTime.Now).Days;
        return daysUntilDeadline <= 3 && daysUntilDeadline >= 0 && task.Status != "Done";
    }

    // Critical Path Detection (Simplified)
    private bool IsCriticalPath(GanttTaskData task)
    {
        // Simplified: Tasks with dependencies are considered critical
        return !string.IsNullOrEmpty(task.Dependencies);
    }

