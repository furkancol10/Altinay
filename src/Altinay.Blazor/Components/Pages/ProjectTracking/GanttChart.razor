    private async Task OnJsDragFinishedInstance(string id, double deltaDays)
    {
        try
        {
            var item = TaskCollection.FirstOrDefault(x => x.Id == id);
            if (item == null) return;
            
            var delta = (int)Math.Round(deltaDays);
            var duration = (item.EndDate - item.StartDate).Days;
            var newStart = item.StartDate.AddDays(delta);
            var newEnd = newStart.AddDays(duration);
            
            // clamp + state update
            item.StartDate = newStart;
            item.EndDate = newEnd;
            item.Duration = duration;
            
            Console.WriteLine($"DRAG FINISHED: {item.Task}");
            Console.WriteLine($"New Start: {item.StartDate:dd/MM/yyyy}");
            Console.WriteLine($"New End: {item.EndDate:dd/MM/yyyy}");
            Console.WriteLine($"Duration: {item.Duration} days");
            
            // DB'YE KAYDET VE KANBAN'DA GÜNCELLE
            await SaveTaskChangesToDatabase(item);
            await NotifyKanbanUpdate(item);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnJsDragFinishedInstance: {ex.Message}");
        }
    }
    
    // Soldan/sağdan resize
    [JSInvokable]
    public static async Task OnJsResizeFinished(string id, string edge, double deltaDays)
    {
        try
        {
            if (_currentInstance != null)
            {
                await _currentInstance.OnJsResizeFinishedInstance(id, edge, deltaDays);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnJsResizeFinished: {ex.Message}");
        }
    }
    
    private async Task OnJsResizeFinishedInstance(string id, string edge, double deltaDays)
    {
        try
        {
            var item = TaskCollection.FirstOrDefault(x => x.Id == id);
            if (item == null) return;
            
            var delta = (int)Math.Round(deltaDays);
            
            if (edge == "left") item.StartDate = item.StartDate.AddDays(delta);
            if (edge == "right") item.EndDate = item.EndDate.AddDays(delta);
            
            // ters dönmesin / clamp
            if (item.StartDate > item.EndDate) item.StartDate = item.EndDate;
            
            item.Duration = (int)(item.EndDate - item.StartDate).TotalDays;
            
            Console.WriteLine($"RESIZE FINISHED: {item.Task}");
            Console.WriteLine($"Edge: {edge}");
            Console.WriteLine($"New Start: {item.StartDate:dd/MM/yyyy}");
            Console.WriteLine($"New End: {item.EndDate:dd/MM/yyyy}");
            Console.WriteLine($"Duration: {item.Duration} days");
            
            // DB'YE KAYDET VE KANBAN'DA GÜNCELLE
            await SaveTaskChangesToDatabase(item);
            await NotifyKanbanUpdate(item);
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnJsResizeFinishedInstance: {ex.Message}");
        }
    }
    
